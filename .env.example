DATABASE_URL=postgres://ads:ads@localhost:5432/ads
REDIS_URL=redis://localhost:6379

# Планировщик и стор-воркер: ios | android | appads
CONTOUR=ios
SCHEDULER_BATCH_SIZE=200
SCHEDULER_INTERVAL=60s
QUEUE_LEASE=10m

# Ритм due (не ретраи)
STORE_INTERVAL=7d
APP_ADS_INTERVAL=24h

# Воркеры
# iOS: WORKER_CONCURRENCY = желаемое число id в полёте, округляется вверх
# до кратного LOOKUP_BATCH_SIZE (10 → 50, 210 → 250). Слот = один Lookup.
# Play / app-ads: WORKER_CONCURRENCY = число слотов, слот = 1 id.
WORKER_CONCURRENCY=4
LOOKUP_BATCH_SIZE=50
STORE_COUNTRY=us
PROXY_URL=
HTTP_TIMEOUT=20s
USER_AGENT=ads-scraper/0.1 (+https://localhost)
BRPOP_TIMEOUT=15s

# Живые HTTP в тестах
LIVE_HTTP=0
